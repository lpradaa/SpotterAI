# Copia esto a `.env` y rellena lo tuyo. El `.env` no se sube al repositorio.
#
#   cp .env.example .env
#
# Lo de arriba hay que tocarlo para desplegar. Lo de abajo tiene valores que
# sirven tal cual.

# =============================================================================
# OBLIGATORIO ANTES DE DESPLEGAR
# =============================================================================

# Firma de los tokens. La aplicacion no arranca sin esto y exige 32 caracteres.
# Genera uno nuevo, no reutilices ninguno que hayas visto escrito en un sitio:
#
#   openssl rand -base64 48
#
JWT_SECRET=

# Contraseña de la base de datos. Cambiala tambien en produccion.
DB_PASSWORD=spotterai

# El origen desde el que se sirve la aplicacion. Con Docker, nginx la sirve
# desde su propio origen y las peticiones no cruzan origenes, pero esto sigue
# valiendo por si alguien ataca la API directamente.
FRONTEND_ORIGIN=http://localhost:4200

# Sin datos de ejemplo en un despliegue de verdad: `demo` siembra catorce
# personas inventadas cada vez que arranca. Dejalo vacio.
SPRING_PROFILES=demo

# La galleta de sesion solo por HTTPS. En false para desarrollo, porque en
# http://localhost una galleta Secure no se manda y no se podria entrar. En
# produccion TIENE que ir en true: si no, la sesion viaja legible por cualquier
# red por la que pase.
COOKIE_SEGURA=false

# =============================================================================
# AVISOS POR CORREO
# =============================================================================
#
# Con CORREO_ACTIVO=false no se manda nada: los avisos se escriben en el
# registro con destinatario, asunto y cuerpo, y se leen con
# `docker compose logs backend`. Es lo que permite verlos sin tener SMTP.
CORREO_ACTIVO=false

# LO PRIMERO QUE HAY QUE CAMBIAR al desplegar de verdad. Es la raiz de los
# enlaces que van dentro de los correos: si se queda en localhost, los avisos
# salen con enlaces que no le funcionan a nadie, y no te vas a dar cuenta,
# porque desde el propio servidor abren perfectamente.
CORREO_URL_BASE=http://localhost:4200

# El remitente. Tiene que ser una direccion que el servidor de abajo te deje
# usar; si no, los correos se rechazan o acaban en spam.
CORREO_REMITENTE=SpotterAI <no-responder@spotterai.local>

# El servidor SMTP. Ojo: con CORREO_ACTIVO=true y sin host, la aplicacion NO
# arranca, asi que esto tiene valor por defecto a proposito.
CORREO_HOST=localhost
CORREO_PUERTO=587
CORREO_USUARIO=
CORREO_CLAVE=

# =============================================================================
# OPCIONAL
# =============================================================================

DB_NAME=spotterai_db

# Cada consulta SQL al registro. Solo para depurar: en produccion llena el
# disco y deja datos de la gente escritos en texto plano en los logs.
SQL_AL_REGISTRO=false

# =============================================================================
# MODERACION
# =============================================================================

# Quien puede ver los reportes en /admin/reportes. Separados por comas.
#
# Vacio significa NADIE, que es el valor correcto por defecto pero tiene una
# consecuencia que conviene saber: la gente puede reportar y los reportes se
# guardan, pero no hay forma de leerlos desde la aplicacion hasta que alguien
# aparezca aqui. Si despliegas esto y quieres moderar, pon tu correo.
#
# No hay roles en la aplicacion: esta lista es la unica decision de
# autorizacion que existe, y es deliberadamente temporal.
ADMIN_EMAILS=

# =============================================================================
# LOS PESOS DEL MOTOR
# =============================================================================
#
# Lo que vale cada factor de la compatibilidad. Los valores de aqui son los que
# usa la aplicacion si no se toca nada, asi que puedes borrar este bloque
# entero y todo sigue igual.
#
# No hace falta que sumen 100: cuando a una pareja le falta algun dato, el peso
# de ese factor se reparte entre los demas en proporcion, asi que lo que
# importa es la relacion entre ellos, no la suma.
#
# Cambiarlos cambia el orden de Explorar para todo el mundo. Antes de tocarlos,
# mira /embudo: es la pantalla que dice si los que hay ahora aciertan.

# Cuando entrenais. El que mas pesa, y con diferencia: es lo unico sin lo cual
# no se puede entrenar junto.
PESO_HORARIO=40

# Que buscais: hipertrofia, fuerza, resistencia...
PESO_OBJETIVO=12

PESO_NIVEL=10

# Si podeis cubriros con la barra cargada, que es para lo que sirve un spotter.
PESO_FUERZA=10

# Si los dos aparecen de verdad. Es el unico factor medido y no declarado.
PESO_CONSTANCIA=10

# Entrenar en el mismo sitio. Ojo: ademas de sus puntos, el gimnasio condiciona
# el factor horario —coincidir a la misma hora en dos edificios distintos no es
# coincidir—, asi que pesa mas de lo que dice este numero.
PESO_GIMNASIO=8

# Como repartis la semana: torso/pierna, weider, cuerpo entero...
PESO_RUTINA=5

PESO_EDAD=5
