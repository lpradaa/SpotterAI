# Copia esto a `.env` y rellena lo tuyo. El `.env` no se sube al repositorio.
#
#   cp .env.example .env
#
# Lo de arriba hay que tocarlo para desplegar. Lo de abajo tiene valores que
# sirven tal cual.

# =============================================================================
# OBLIGATORIO ANTES DE DESPLEGAR
# =============================================================================

# Firma de los tokens. La aplicacion no arranca sin esto y exige 32 caracteres.
# Genera uno nuevo, no reutilices ninguno que hayas visto escrito en un sitio:
#
#   openssl rand -base64 48
#
JWT_SECRET=

# Contraseña de la base de datos. Cambiala tambien en produccion.
DB_PASSWORD=spotterai

# El origen desde el que se sirve la aplicacion. Con Docker, nginx la sirve
# desde su propio origen y las peticiones no cruzan origenes, pero esto sigue
# valiendo por si alguien ataca la API directamente.
FRONTEND_ORIGIN=http://localhost:4200

# Sin datos de ejemplo en un despliegue de verdad: `demo` siembra catorce
# personas inventadas cada vez que arranca. Dejalo vacio.
SPRING_PROFILES=demo

# =============================================================================
# AVISOS POR CORREO
# =============================================================================
#
# Con CORREO_ACTIVO=false no se manda nada: los avisos se escriben en el
# registro con destinatario, asunto y cuerpo, y se leen con
# `docker compose logs backend`. Es lo que permite verlos sin tener SMTP.
CORREO_ACTIVO=false

# LO PRIMERO QUE HAY QUE CAMBIAR al desplegar de verdad. Es la raiz de los
# enlaces que van dentro de los correos: si se queda en localhost, los avisos
# salen con enlaces que no le funcionan a nadie, y no te vas a dar cuenta,
# porque desde el propio servidor abren perfectamente.
CORREO_URL_BASE=http://localhost:4200

# El remitente. Tiene que ser una direccion que el servidor de abajo te deje
# usar; si no, los correos se rechazan o acaban en spam.
CORREO_REMITENTE=SpotterAI <no-responder@spotterai.local>

# El servidor SMTP. Ojo: con CORREO_ACTIVO=true y sin host, la aplicacion NO
# arranca, asi que esto tiene valor por defecto a proposito.
CORREO_HOST=localhost
CORREO_PUERTO=587
CORREO_USUARIO=
CORREO_CLAVE=

# =============================================================================
# OPCIONAL
# =============================================================================

DB_NAME=spotterai_db

# Cada consulta SQL al registro. Solo para depurar: en produccion llena el
# disco y deja datos de la gente escritos en texto plano en los logs.
SQL_AL_REGISTRO=false
